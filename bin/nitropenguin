#!/bin/bash
# Launch NitroPenguin directly from the project venv.
# Self-locating: resolves the repo dir even when invoked through a
# symlink in ~/.local/bin, so it works wherever the project is cloned.
# We exec the venv entry point directly (no `uv run` wrapper) to avoid
# keeping a ~32 MB uv process resident as the GUI's parent.
SELF="$(readlink -f "$0")"
PROJECT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
exec "$PROJECT_DIR/.venv/bin/nitropenguin" "$@"
